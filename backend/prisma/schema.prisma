// Modelo de dados do Sistema de Gestão de Ativos de TI.
// Conceito central: um EQUIPAMENTO é entregue a um USUÁRIO através de uma
// ATRIBUIÇÃO (Assignment). Toda ação relevante gera um registro de AUDITORIA.
//
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuários do sistema. O papel (role) define o que cada um pode fazer.
// ADMIN: gerencia equipamentos e atribuições.
// COLLABORATOR: recebe equipamentos e assina termos.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique
  passwordHash String
  role         Role     @default(COLLABORATOR)
  jobTitle     String? // cargo (texto livre); opcional para não quebrar usuários antigos
  sector       Sector? // setor da empresa; obrigatório na API, nullable no DB para usuários antigos
  // "Excluir" um usuário é uma baixa lógica (active=false), não uma remoção
  // real: apagar a linha quebraria o histórico de atribuições e auditoria
  // que a referenciam. Usuários inativos somem das listas e não logam mais.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Atribuições em que este usuário é o RECEBEDOR do equipamento
  assignmentsReceived Assignment[] @relation("AssignmentReceiver")
  // Atribuições registradas por este usuário (quando é admin)
  assignmentsCreated  Assignment[] @relation("AssignmentCreator")
  // Ações de auditoria realizadas por este usuário
  auditLogs           AuditLog[]
  // Pedidos de "esqueci minha senha" feitos / resolvidos por este usuário
  passwordResetRequests    PasswordResetRequest[] @relation("ResetRequester")
  resolvedPasswordResets   PasswordResetRequest[] @relation("ResetResolver")
}

enum Role {
  ADMIN
  COLLABORATOR
}

enum Sector {
  TI
  MARKETING
  COMERCIAL
  NAILS
  RH
  PRODUCAO_AB
  FINANCEIRO
  DIRETORIA
  TRADE
  EDUCACIONAL
  FISCAL
  PRODUCAO_NAILS
  INSIDE_SALES
  COMEX
}

// ---------------------------------------------------------------------------
// Equipamentos (ativos). Cada um tem um status que muda conforme o ciclo de
// vida: disponível -> atribuído -> (manutenção) -> disponível -> baixado.
// ---------------------------------------------------------------------------
model Equipment {
  id            String          @id @default(uuid())
  name          String
  serialNumber  String?         @unique
  status        EquipmentStatus @default(AVAILABLE)
  purchaseDate  DateTime?
  warrantyUntil DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Tipo agora é uma tabela própria, permitindo cadastrar novos tipos.
  type   EquipmentType @relation(fields: [typeId], references: [id])
  typeId String

  assignments     Assignment[]
  maintenances    MaintenanceRecord[]
  credentials     DeviceCredential[]
  auditLogs       AuditLog[]
}

// Tipos de equipamento (notebook, celular, etc.). Cadastráveis em runtime.
model EquipmentType {
  id        String      @id @default(uuid())
  name      String      @unique
  // Define se o nº de série é obrigatório ao cadastrar equipamentos deste
  // tipo. Ex.: Notebook exige; Periférico/Outro não.
  serialRequired Boolean @default(true)
  createdAt DateTime    @default(now())
  equipments Equipment[]
  automations Automation[]
}

// ---------------------------------------------------------------------------
// Automações: regras configuráveis que reagem a eventos do sistema. Por ora
// há um tipo (LOW_STOCK): avisar por e-mail quando os disponíveis de um tipo
// de equipamento chegam a um limite. Uma automação por tipo (várias linhas).
// ---------------------------------------------------------------------------
model Automation {
  id              String            @id @default(uuid())
  type            AutomationType    @default(LOW_STOCK)
  name            String
  equipmentType   EquipmentType     @relation(fields: [equipmentTypeId], references: [id])
  equipmentTypeId String
  threshold       Int // limite N: alerta quando disponíveis <= N
  channel         AutomationChannel @default(EMAIL)
  recipient       String // e-mail que deve receber o aviso
  active          Boolean           @default(true)
  // "Já avisei": garante o disparo só na VIRADA (>N -> <=N). Reseta quando o
  // estoque volta a subir acima do limite.
  alreadyAlerted  Boolean           @default(false)
  lastTriggeredAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum AutomationType {
  LOW_STOCK
}

enum AutomationChannel {
  EMAIL
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

// ---------------------------------------------------------------------------
// Atribuição = o vínculo entre um equipamento e quem está com ele.
// returnedAt nulo significa que o equipamento ainda está em poder do usuário.
// ---------------------------------------------------------------------------
model Assignment {
  id            String           @id @default(uuid())
  status        AssignmentStatus @default(ACTIVE)
  assignedAt    DateTime         @default(now())
  returnedAt    DateTime?
  notes         String?
  termPdfPath   String? // caminho do PDF do termo gerado

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String

  // Quem recebeu o equipamento
  receiver   User   @relation("AssignmentReceiver", fields: [receiverId], references: [id])
  receiverId String

  // Admin que registrou a entrega
  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AssignmentStatus {
  ACTIVE // equipamento entregue, ainda não devolvido
  RETURNED // devolvido normalmente
}

// ---------------------------------------------------------------------------
// Manutenções programadas / realizadas em um equipamento.
// Base para os "alertas de manutenção" do dashboard.
// ---------------------------------------------------------------------------
model MaintenanceRecord {
  id           String    @id @default(uuid())
  description  String
  scheduledFor DateTime
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String
}

// ---------------------------------------------------------------------------
// Trilha de auditoria: registro imutável de "quem fez o quê e quando".
// É o diferencial de compliance do projeto — nada é apagado, só registrado.
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  action     String // ex: "EQUIPMENT_CREATED", "ASSIGNMENT_RETURNED"
  entity     String // ex: "Equipment", "Assignment"
  entityId   String
  metadata   Json? // dados extras do evento
  createdAt  DateTime @default(now())

  performedBy   User?   @relation(fields: [performedById], references: [id])
  performedById String?

  // Equipamento relacionado ao evento (quando houver), permitindo filtrar
  // a trilha por tipo de equipamento (notebook, celular, etc.).
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  equipmentId String?
}

// ---------------------------------------------------------------------------
// Cofre de senhas dos aparelhos (ex: senha do BIOS, conta do SO, PIN).
// IMPORTANTE: o segredo é CRIPTOGRAFADO (AES-256-GCM), não hasheado, pois
// precisa ser recuperável. secretEncrypted/iv/authTag são os 3 pedaços
// necessários para decifrar. A chave-mestra fica FORA do banco (no .env).
// ---------------------------------------------------------------------------
model DeviceCredential {
  id              String   @id @default(uuid())
  label           String // ex: "Senha BIOS", "Conta admin Windows"
  username        String? // opcional (ex: usuário da conta)
  secretEncrypted String // texto cifrado (hex)
  iv              String // vetor de inicialização do AES-GCM (hex)
  authTag         String // tag de autenticação do GCM (hex)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String
}

// ---------------------------------------------------------------------------
// Pedido de "esqueci minha senha": o colaborador informa o e-mail no login,
// e o pedido aparece para o admin em Solicitações, que define uma nova
// senha diretamente ali (o projeto não tem envio de e-mail).
// ---------------------------------------------------------------------------
model PasswordResetRequest {
  id         String            @id @default(uuid())
  email      String
  status     ResetRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?

  user   User   @relation("ResetRequester", fields: [userId], references: [id])
  userId String

  resolvedBy   User?   @relation("ResetResolver", fields: [resolvedById], references: [id])
  resolvedById String?
}

enum ResetRequestStatus {
  PENDING
  RESOLVED
}
